{
  "name": "academic-homepage-template",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "A four-page academic portfolio built with Astro, BibTeX, and editable profile data.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run tests",
    "verify": "pnpm test && pnpm exec astro check && pnpm build",
    "build:pages": "python3 scripts/build_pages.py",
    "deploy:pages": "pnpm run build:pages && gh-pages --dist site-export --dotfiles"
  },
  "license": "MIT",
  "keywords": [
    "astro",
    "theme",
    "portfolio",
    "academic",
    "unocss"
  ],
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "astro": "7.3.1",
    "astro-seo": "^1.2.0",
    "sharp": "0.35.4",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@iconify-json/academicons": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@playwright/test": "1.63.0",
    "gh-pages": "6.3.0",
    "unocss": "^66.10.0",
    "vitest": "^5.0.0"
  }
}
